# Port & Runtime
PORT=3000
NODE_ENV=production
APP_URL=http://localhost
APP_DOMAIN=localhost

# Database (PostgreSQL 16)
POSTGRES_USER=plioou
POSTGRES_PASSWORD=gere_uma_senha_forte_aqui
