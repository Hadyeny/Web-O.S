SIGNATURE_SECRET=gere_uma_chave_hmac_sha256_com_openssl_rand_base64_32

# Bootstrap Initial Admin (Optional - generated randomly if omitted)
ADMIN_PASSWORD=SenhaSeguraInicialAdmin2026!

# Log Level: debug, info, warn, error
LOG_LEVEL=info
